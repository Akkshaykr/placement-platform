# Copy this file to `.env.local` and fill in YOUR values. `.env.local` is git-ignored.
# Everything prefixed VITE_ is compiled into the public browser bundle: treat it as public.
# NEVER put a service_role key, a "secret" key (sb_secret_...), or any API key here.

# Supabase project URL.
#   Hosted project:  https://YOUR_PROJECT_REF.supabase.co     (Dashboard > Project Settings > API)
#   Local stack:     http://127.0.0.1:54321                    (printed by `npx supabase start`)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_...). The legacy "anon" key also works.
# The app refuses to start if it detects a secret or service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional. Public URL of the deployed site, used for auth redirects.
# Leave empty to use the address the app is served from.
VITE_APP_URL=

# ---------------------------------------------------------------------------------------------
# Server-side secrets are NOT stored in this file.
#   * Gemini API key (phase 4):  set with `npx supabase secrets set GEMINI_API_KEY=...`
#   * Google OAuth client secret: configure in the Supabase dashboard (hosted), or export
#     SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET in your
#     shell for the local stack (see docs/oauth-setup.md).
# ---------------------------------------------------------------------------------------------
